# 複製為 .env.local(本機開發用,已被 .gitignore 排除)
# 正式部署時改在 GitHub repo Settings → Secrets and variables → Actions 設定同名 secrets

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Web Push VAPID 公鑰(npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# 選填:兩位使用者的 Supabase Auth email 與顯示名稱(以下為程式預設值)
# VITE_USER_A_EMAIL=Kenneth_Lin@missionapp.app
# VITE_USER_A_NAME=Kenneth
# VITE_USER_B_EMAIL=Juniper_Kuo@missionapp.app
# VITE_USER_B_NAME=Juniper
