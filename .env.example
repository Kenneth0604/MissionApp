# 複製為 .env.local(本機開發用,已被 .gitignore 排除)
# 正式部署時改在 GitHub repo Settings → Secrets and variables → Actions 設定同名 secrets

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Web Push VAPID 公鑰(npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# 選填:A / B 在 Supabase Auth 中的帳號 email(預設 a@missionapp.app / b@missionapp.app)
# VITE_USER_A_EMAIL=a@missionapp.app
# VITE_USER_B_EMAIL=b@missionapp.app
